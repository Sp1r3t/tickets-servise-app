# Copy manually and replace placeholders, or run python scripts/init_env.py.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
INTERNAL_SECRET=replace-with-another-random-secret-of-at-least-32-characters
ENVIRONMENT=development
DEMO_PAYMENTS=true
COOKIE_SECURE=false
HOLD_SECONDS=600
# DATABASE_URL is set separately for EACH service in Docker Compose.
IDENTITY_DB_PASSWORD=replace-with-a-random-password
CATALOG_DB_PASSWORD=replace-with-a-random-password
INVENTORY_DB_PASSWORD=replace-with-a-random-password
ORDERS_DB_PASSWORD=replace-with-a-random-password
PAYMENTS_DB_PASSWORD=replace-with-a-random-password
